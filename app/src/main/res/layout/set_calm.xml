<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout style="@style/Box" android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quiet"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/quiet_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:text="@string/quiet_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quiet_from"
                style="@style/TextButton" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="@string/until"
                android:textColor="@color/ink_soft" />

            <TextView
                android:id="@+id/quiet_to"
                style="@style/TextButton" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/Box">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gap"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/gaps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/stay"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/stays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/test"
            style="@style/TextButton"
            android:layout_marginTop="18dp"
            android:text="@string/test" />
    </LinearLayout>
</LinearLayout>
