<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/page_inbox"
            layout="@layout/inbox_page" />

        <include
            android:id="@+id/page_history"
            layout="@layout/history_page"
            android:visibility="gone" />

        <include
            android:id="@+id/page_stats"
            layout="@layout/stats_page"
            android:visibility="gone" />

        <include
            android:id="@+id/page_settings"
            layout="@layout/settings_page"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/nav_bar"
        android:orientation="horizontal">

        <include
            android:id="@+id/tab_inbox"
            layout="@layout/tab" />

        <include
            android:id="@+id/tab_history"
            layout="@layout/tab" />

        <include
            android:id="@+id/tab_stats"
            layout="@layout/tab" />

        <include
            android:id="@+id/tab_settings"
            layout="@layout/tab" />
    </LinearLayout>
</LinearLayout>
